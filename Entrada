void mousePressed() {
  if (pantalla == 1) {
    for (int i = 0; i < botonesMenu.length; i++) {
      if (botonesMenu[i].sobreBoton) {
        if (i == 0) {
          musicaMenu.stop();
          musicaJuego.loop();
          musicaJuego.amp(0.5);
          reiniciarPartida();
          pantalla = 1.5;
        } else {
          pantalla = i + 2;
        }
      }
    }

  } else if (pantalla == 2) {
    if (gameOver) {
      if (sobreRect(width / 2 - 50, height / 2 + 150, 80, 60)) {
        reiniciarPartida();
      } else if (sobreRect(width / 2 + 50, height / 2 + 150, 80, 60)) {
        volverAlMenu();
      }

    } else if (juegoGanado) {
      if (sobreRect(width / 2, height - 100, 160, 50)) {
        volverAlMenu();
      }

    } else {
      float bx = width - 70;
      float by = 45;

      if (sobreRect(bx, by, 90, 40)) {
        juegoPausado = !juegoPausado;
      } else if (juegoPausado) {
        float btnY1 = height / 2 + 5;
        float btnY2 = height / 2 + 65;

        if (sobreRect(width / 2, btnY1, 200, 44)) {
          juegoPausado = false;
        } else if (sobreRect(width / 2, btnY2, 200, 44)) {
          volverAlMenu();
        }
      }
    }

  } else {
    if (pantalla == 4) {
      float inicioX = width / 2 - 260;

      // Selección de dificultad
      if (mouseY >= height / 2 - 99 && mouseY <= height / 2 - 61) {
        if (sobreRect(inicioX + 180, height / 2 - 80, 100, 38)) dificultad = 1;
        else if (sobreRect(inicioX + 295, height / 2 - 80, 110, 38)) dificultad = 2;
        else if (sobreRect(inicioX + 420, height / 2 - 80, 110, 38)) dificultad = 3;
      }

      // Selección de velocidad
      if (mouseY >= height / 2 - 19 && mouseY <= height / 2 + 19) {
        if (sobreRect(inicioX + 180, height / 2, 100, 38)) velocidadNave = 3;
        else if (sobreRect(inicioX + 295, height / 2, 110, 38)) velocidadNave = 6;
        else if (sobreRect(inicioX + 420, height / 2, 110, 38)) velocidadNave = 9;
      }
    }

    // En este bloque solo pueden estar las pantallas 3, 4 y 5.
    if (sobreRect(width / 2, height - 100, 160, 50)) {
      pantalla = 1;
    }
  }
}

void keyPressed() {
  if (keyCode == ENTER && pantalla == 2 && !gameOver && !juegoGanado) {
    juegoPausado = !juegoPausado;
  }

  if (key == 'w' || key == 'W' || keyCode == UP) arriba = true;
  if (key == 'a' || key == 'A' || keyCode == LEFT) izquierda = true;
  if (key == 's' || key == 'S' || keyCode == DOWN) abajo = true;
  if (key == 'd' || key == 'D' || keyCode == RIGHT) derecha = true;
  if (key == ' ') espacio = true;
  if ((key == 's' || key == 'S') && pantalla == 1.5) pantalla = 2;
}

void keyReleased() {
  if (key == 'w' || key == 'W' || keyCode == UP) arriba = false;
  if (key == 'a' || key == 'A' || keyCode == LEFT) izquierda = false;
  if (key == 's' || key == 'S' || keyCode == DOWN) abajo = false;
  if (key == 'd' || key == 'D' || keyCode == RIGHT) derecha = false;
  if (key == ' ') espacio = false;

  // Atajos de prueba conservados del proyecto original.
  if (keyCode == TAB) juegoGanado = true;
  if (keyCode == ALT) gameOver = true;
}

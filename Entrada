// ---------- Teclas ----------

boolean arriba;
boolean izquierda;
boolean abajo;
boolean derecha;
boolean espacio = false;

void mousePressed() {
  if (pantalla == 1) {
    for (i = 0; i < botonesMenu.length; i++) {
      if (botonesMenu[i].sobreBoton) {
        if (i == 0) {
          reiniciarPartida();
          pantalla = 1.5;
        } else {
          pantalla = i + 2;
        }
        break;
      }
    }
  } else if (pantalla == 2) {
    if (juegoGanado) {
      if (botonAtras.sobreBoton) {
        reiniciarPartida();
        volverAlMenu();
      }
    } else if (gameOver) {
      if (botonSi.sobreBoton) {
        reiniciarPartida();
      } else if (botonNo.sobreBoton) {
        volverAlMenu();
      }
    } else if (juegoPausado) {
      if (botonContinuar.sobreBoton) {
        juegoPausado = false;
      } else if (botonInicio.sobreBoton) {
        volverAlMenu();
      }
    } else if (botonPausa.sobreBoton) {
      juegoPausado = true;
    }
  } else if (pantalla >= 3) {
    if (pantalla == 4) {
      for (i = 0; i < botonesDificultad.length; i++) {
        if (botonesDificultad[i].sobreBoton) {
          dificultad = i + 1;
        }

        if (botonesVelocidad[i].sobreBoton) {
          velocidadNave = (i + 1) * 3;
        }
      }
    }

    if (botonAtras.sobreBoton) {
      pantalla = 1;
    }
  }
}

void keyPressed() {
  if (pantalla == 1.5 && key == ' ') {
    pantalla = 2;
  } else if (pantalla == 2 && !gameOver && !juegoGanado) {
    if (keyCode == ENTER) {
      juegoPausado = !juegoPausado;
    } else if (!juegoPausado) {
      if (key == 'w' || key == 'W' || keyCode == UP) arriba = true;
      if (key == 'a' || key == 'A' || keyCode == LEFT) izquierda = true;
      if (key == 's' || key == 'S' || keyCode == DOWN) abajo = true;
      if (key == 'd' || key == 'D' || keyCode == RIGHT) derecha = true;
      if (key == ' ') espacio = true;
    }
  }
}

void keyReleased() {
  if (key == 'w' || key == 'W' || keyCode == UP) arriba = false;
  if (key == 'a' || key == 'A' || keyCode == LEFT) izquierda = false;
  if (key == 's' || key == 'S' || keyCode == DOWN) abajo = false;
  if (key == 'd' || key == 'D' || keyCode == RIGHT) derecha = false;
  if (key == ' ') espacio = false;

  if (keyCode == TAB) juegoGanado = true;
  if (keyCode == ALT) gameOver = true;
}

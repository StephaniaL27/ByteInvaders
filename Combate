// ---------- Vidas y puntuación ----------

int cantidadVidas = 3;
int Puntos = 0;
int aliadosCaidos = 0;

float radioChoque = 70;

// ---------- HUD ----------

int FrameActualC = 0;

float Xinicial = 100;
float Y = 70;
float distanciaC = 50;

PImage[] FramesC = new PImage[8];

void dibujarVidas() {
  if (!juegoPausado && frameCount % FPS == 0) {
    FrameActualC = (FrameActualC + 1) % FramesC.length;
  }

  for (i = 0; i < cantidadVidas; i++) {
    image(FramesC[FrameActualC], Xinicial + distanciaC * i, Y, 64, 64);
  }
}

void perderVida() {
  cantidadVidas--;
  if (cantidadVidas <= 0) {
    cantidadVidas = 0;
    gameOver = true;
  }
}

void choqueNaves() {
  for (i = 0; i < maxEnemigos; i++) {
    if (existe[i] && abs(enemigo[i].x - jugador.x) < radioChoque &&
      abs(enemigo[i].y - jugador.y) < radioChoque) {

      switch (enemigo[i].tipo) {
      case 1:
        sfxExplosion.play();
        perderVida();
        break;
      case 2:
        Puntos += 100;
        if (cantidadVidas < 3) {
          cantidadVidas++;
        }
        break;
      case 3:
        inicioCooldown = millis();
        duracionCooldown = 2000;
        break;
      }

      existe[i] = false;
    }
  }
}

void dibujarJuego() {
  if (!juegoGanado && !gameOver) {
    jugador.dibujarNave();

    for (i = 0; i < maxEnemigos; i++) {
      if (existe[i]) enemigo[i].dibujarNave();
    }

    dibujarDisparos();
    dibujarVidas();

    textoPuntos.Contenido = String.valueOf(Puntos);
    textoPuntos.dibujarTexto();

    if (!juegoPausado) {
      moverJugador();
      moverEnemigos();

      if (espacio && millis() - inicioCooldown >= duracionCooldown) disparar();

      derribarEnemigo();
      choqueNaves();

      if (nahIdWin(0, maxEnemigos) == 1 && !gameOver) {
        juegoGanado = true;
        sfxVictory.play();
      }
    }
  }

  if (juegoGanado) {
    dibujarVictoria();
  } else if (gameOver) {
    dibujarGameOver();
  } else {
    if (juegoPausado) dibujarVentanaPausa();
    else botonPausa.dibujarBoton();
  }
}

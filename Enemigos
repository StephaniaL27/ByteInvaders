// ---------- Enemigos ----------

int maxEnemigos = 27;
int[] direccionEnemigo = {1, -1, 1};

float velocidadEnemigo;

boolean[] existe = new boolean[maxEnemigos];
Naves[] enemigo = new Naves[maxEnemigos];

void crearEnemigos() {
  int tipoNave;

  k = 0;

  for (i = 0; i < 3; i++) {
    for (j = 0; j < 9; j++) {
      tipoNave = int(random(1, 4));
      float enemigoX = width / 2 - 4 * 128 + j * 128;
      float enemigoY = 64 + i * 128;
      enemigo[k] = new Naves(tipoNave, enemigoX, enemigoY);
      existe[k] = true;
      k++;
    }
  }
}

void moverEnemigos() {
  float minX = 64;
  float maxX = width - 64;

  // Cambia la dirección de cada fila cuando alcanza un extremo.

  for (i = 0; i < maxEnemigos; i++) {
    int fila = i / 9;
    if (existe[i]) {
      if (direccionEnemigo[fila] == -1 && enemigo[i].x <= minX) {
        direccionEnemigo[fila] = 1;
      } else if (direccionEnemigo[fila] == 1 && enemigo[i].x >= maxX) {
        direccionEnemigo[fila] = -1;
      }
    }
  }

  for (i = 0; i < maxEnemigos; i++) {
    int fila = i / 9;
    if (existe[i]) enemigo[i].x += velocidadEnemigo * direccionEnemigo[fila];
  }
}

int nahIdWin(int i, int t) {
  int gojoWon = 1;
  if (i < t) {
    if (existe[i] && enemigo[i].tipo == 1) {
      gojoWon = 0;
    } else {
      gojoWon = nahIdWin(i + 1, t);
    }
  }
  return gojoWon;
}
